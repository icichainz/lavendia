<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The main manifest sets usesCleartextTraffic="false" to close the gap
         on API 23, where android:networkSecurityConfig is ignored (it was
         introduced in API 24) and minSdk here is 23. Debug builds need the
         opposite so a device can reach a Django server on a LAN IP. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
